  tutorialImages:
  - {fileID: 21300000, guid: 2fc96637afb55904d91db591275a7b04, type: 3}
  - {fileID: 21300000, guid: 5c513804e365dae4fbb7858117790417, type: 3}
  - {fileID: 21300000, guid: e13821edb6b82f14f8d18ef54679cc8a, type: 3}
  - {fileID: 21300000, guid: d9ee0e00b22085448879527d60265e95, type: 3}
  - {fileID: 21300000, guid: 300a16df82b8fc141ab5a32a20369b12, type: 3}
  - {fileID: 21300000, guid: 457d11d737e1dc04dacf989665c866a5, type: 3}
  - {fileID: 21300000, guid: 1b6e14ed50dfeb3409cae07bc40c99a7, type: 3}
  - {fileID: 21300000, guid: d84294c1d30a7a64b80c10df2b572eb0, type: 3}
  - {fileID: 21300000, guid: e471cb104f7793046bd3b3d5cf8435f3, type: 3}
  - {fileID: 21300000, guid: 555a1e14dc1f1794ea5303904623f685, type: 3}
  - {fileID: 21300000, guid: e06e6ab22fbad7243b89a38ad486cb63, type: 3}
  - {fileID: 21300000, guid: ef91c539d863e334bbc6d33bfa6b1f87, type: 3}
  - {fileID: 21300000, guid: 73529be57905499438d9956562ddeb01, type: 3}
  - {fileID: 21300000, guid: 06da29ed6221f81439f1e72f79dcc9f4, type: 3}
  - {fileID: 21300000, guid: dab0fc05428cb2249877f6996baf6fd9, type: 3}
  - {fileID: 21300000, guid: 789b688390fd9a1448206ceffa199ce6, type: 3}
  - {fileID: 21300000, guid: 5e104a7994ed2ed468d2edeed498cb01, type: 3}
  - {fileID: 21300000, guid: cbaed2e5c58fc1747b5f6c1d73d7fc02, type: 3}
  - {fileID: 21300000, guid: 09864f5bb18041643842552e1286990a, type: 3}
  - {fileID: 21300000, guid: ec9fa637545219342a4163d41538fc7a, type: 3}
  tutorialTexts:
  - "Turn Fight \uD29C\uD1A0\uB9AC\uC5BC\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4."
  - "\uC2DC\uC791\uD558\uAE30\uC5D0 \uC55E\uC11C \uAC01 \uB09C\uC774\uB3C4 \uBCC4\uB85C
    \uC815\uB9AC\uB418\uC5B4 \uC788\uC73C\uB2C8\n\uD50C\uB808\uC774 \uD558\uC2E4
    \uB54C \uCC38\uACE0\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - "\uC774 \uAC8C\uC784\uC740 \uACF5\uACA9\uACFC \uC218\uBE44\uB97C \uBC88\uAC08\uC544
    \uAC00\uBA74\uC11C \uC9C4\uD589\uD558\uB294\n\uB9AC\uB4EC \uACA9\uD22C \uAC8C\uC784\uC785\uB2C8\uB2E4."
  - "\uC0C1\uB2E8\uC5D0 \uBCF4\uC774\uB294 UI\uB294 \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4."
  - "\uD328\uD134 \uBC14\uC5D0\uB294 \uD0C0\uC774\uBC0D \uBC14\uC640 \uB9C8\uB514\uC120\uC774
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD0C0\uC774\uBC0D \uBC14\uB294 \uAC8C\uC784 \uC9C4\uD589 \uC2DC\n\uC67C\uCABD\uC5D0\uC11C
    \uC624\uB978\uCABD\uC73C\uB85C \uC9C0\uB098\uAC11\uB2C8\uB2E4."
  - "\uACF5\uACA9\uC790\uB294 \uD0C0\uC774\uBC0D \uBC14\uC640 \uB9C8\uB514\uC120\uC774
    \uC77C\uCE58\uD558\uB294\n\uD0C0\uC774\uBC0D\uC5D0 \uACF5\uACA9 \uD0A4\uB97C
    \uB204\uB974\uBA74 \uD574\uB2F9 \uBC84\uD2BC\uC774\n\uD328\uD134\uC73C\uB85C
    \uC800\uC7A5\uB429\uB2C8\uB2E4."
  - "\uACF5\uACA9 \uD0A4\uB294 \uB2E4\uC74C\uACFC \uAC19\uC2B5\uB2C8\uB2E4.\n<color=#FF5555>\uD50C\uB808\uC774\uC5B4
    1 = \uD654\uC0B4\uD45C + \uC2A4\uD398\uC774\uC2A4 \uBC14 (S)\n<color=#56CCF2>\uD50C\uB808\uC774\uC5B4
    2 = numpad 4568 + A (S)"
  - "\uD0C0\uC774\uBC0D \uBC14\uAC00 \uBAA8\uB4E0 \uB9C8\uB514\uC120\uC744 \uC9C0\uB0A0
    \uACBD\uC6B0\n\uACF5\uACA9\uC790\uAC00 \uC800\uC7A5\uD55C \uD328\uD134\uC744
    \uD1A0\uB300\uB85C\n\uC218\uBE44\uC790\uAC00 \uBC29\uC5B4\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uC218\uBE44\uC790\uB294 \uD0C0\uC774\uBC0D \uBC14\uC640 \uB9C8\uB514\uC120\uC774
    \uC77C\uCE58\uD558\uB294\n\uD0C0\uC774\uBC0D\uC5D0 \uB3D9\uC77C\uD55C \uACF5\uACA9
    \uD0A4\uB97C \uB204\uB974\uBA74\n\uD574\uB2F9 \uACF5\uACA9\uC744 \uBC29\uC5B4\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC77C\uCE58\uD558\uB294 \uD0C0\uC774\uBC0D\uC5D0 \uC218\uBE44\uB97C \uC131\uACF5\uD560
    \uACBD\uC6B0,\n\uCCB4\uB825\uC774 \uAC10\uC18C\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. "
  - "\uB9CC\uC57D, \uD0C0\uC774\uBC0D\uC774 \uC77C\uCE58\uD558\uC9C0 \uC54A\uAC70\uB098
    \uC798\uBABB\uB41C \uACF5\uACA9 \uD0A4\uB97C \uC785\uB825\n\uD639\uC740 \uC544\uC608
    \uB204\uB974\uC9C0 \uC54A\uB294 \uACBD\uC6B0 \uCCB4\uB825\uC774 \uB2F3\uAC8C
    \uB429\uB2C8\uB2E4."
  - "\uC544\uBB34 \uD328\uD134\uB3C4 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC744 \uB54C\uC5D0
    \uACF5\uACA9 \uD0A4\uB97C \uC785\uB825\uD560 \uACBD\uC6B0\n\uC18C\uB7C9\uC5D0
    \uCCB4\uB825\uC774 \uAC10\uC18C\uD558\uAC8C \uB418\uB2C8 \uC720\uC758\uD558\uC138\uC694!"
  - "\uD55C \uB77C\uC6B4\uB4DC\uC5D0 \uBAA8\uB4E0 \uACF5\uACA9\uC744 \uCCB4\uB825
    \uAC10\uC18C \uC5C6\uC774 \uC218\uBE44\uD560 \uACBD\uC6B0\n\uC644\uBCBD\uD55C
    \uC218\uBE44\uAC00 \uB418\uBA70 \uCCB4\uB825\uC774 \uC18C\uB7C9 \uC0C1\uC2B9\uD569\uB2C8\uB2E4!"
  - "\uACF5\uACA9\uACFC \uC218\uBE44\uAC00 \uAC01\uAC01 3\uD68C \uAC04 \uC8FC\uACE0
    \uBC1B\uC558\uB2E4\uBA74\n\uB77C\uC6B4\uB4DC\uAC00 \uC99D\uAC00\uD558\uAC8C \uB429\uB2C8\uB2E4.\n\uC774\uB54C
    \uACF5\uACA9\uACFC \uC218\uBE44\uAC00 \uBCC0\uACBD\uB429\uB2C8\uB2E4."
  - "6\uB77C\uC6B4\uB4DC\uAC00 \uB05D\uB098\uAC70\uB098 \uC0C1\uB300\uC758 \uCCB4\uB825\uC774
    0\uC774 \uB420 \uACBD\uC6B0\n\uAC8C\uC784\uC774 \uC885\uB8CC\uD558\uAC8C \uB429\uB2C8\uB2E4.
    \uC0C1\uB300\uBCF4\uB2E4.\n\uB192\uC740 \uCCB4\uB825\uC744 \uC720\uC9C0\uD558\uC138\uC694!"
  - "\uCEF4\uD4E8\uD130\uC640 \uB300\uACB0\uD560 \uACBD\uC6B0, \uD50C\uB808\uC774\uC5B4
    1\uB85C \uC9C4\uD589\uB418\uBA70 \uC218\uBE44\uC790\uBD80\uD130\n\uC2DC\uC791\uD569\uB2C8\uB2E4. "
  - "\uCEF4\uD4E8\uD130\uC640 \uB300\uACB0\uD560 \uB54C \uD50C\uB808\uC774\uC5B4\uAC00
    \uACF5\uACA9 \uC790\uCCB4\uAC00 \uB418\uBA74\n\uD2B9\uC218\uD55C \uACF5\uACA9\uC744
    \uC900\uBE44\uD558\uAC8C \uB429\uB2C8\uB2E4."
  - "\uD2B9\uC218\uD55C \uACF5\uACA9\uC744 \uC900\uBE44\uD560 \uB54C 7.5\uCD08 \uC774\uB0B4
    \uC544\uBB34 \uACF5\uACA9 \uD0A4\uB97C\n100\uD68C \uC785\uB825\uD558\uBA74 \uACF5\uACA9\uC774
    \uB4E4\uC5B4\uAC11\uB2C8\uB2E4!"
  - "\uC774\uAC83\uC73C\uB85C \uD29C\uD1A0\uB9AC\uC5BC\uC744 \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4.\n\uADF8\uB7FC
    \uC990\uAC81\uAC8C \uC990\uACA8\uC8FC\uC138\uC694!"
